# Optional but recommended: raises GitHub API rate limit from 60/hr to 5,000/hr.
# Generate at https://github.com/settings/tokens?type=beta with read-only "Public Repositories" access, no other scopes needed.
GITHUB_TOKEN=

# Required: shared secret for POST /api/refresh and the admin review queue (PATCH /api/admin/repos/*).
# Generate any long random string, e.g.: openssl rand -hex 32
ADMIN_TOKEN=

# Optional: where the SQLite file lives. Defaults to ./data/skills.db
DATABASE_PATH=./data/skills.db
